# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Logs and simulation outputs
# ---------------------------------------------------------------------------
*.log
results/

# ---------------------------------------------------------------------------
# Patch / merge leftovers and agent scratch files
# ---------------------------------------------------------------------------
*.orig
*.rej
*.patch
.codex_tmp_*

# ---------------------------------------------------------------------------
# IDE / editor / local tooling
# ---------------------------------------------------------------------------
.idea/
.vscode/
# `.claude/*` (contents), not `.claude/` (the directory): git cannot re-include
# a path inside an excluded directory, so an exclude on the directory itself
# would make the negation below dead.
.claude/*
# The project instructions are part of the codebase; local machine state
# (settings*.json, *.lock) is not.  Both spellings are listed because the file
# is `claude.md` on disk and only matches `CLAUDE.md` while `core.ignorecase`
# is true -- which it is on Windows but not on a Linux clone.
!.claude/CLAUDE.md
!.claude/claude.md

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# LaTeX build products of the standalone chapter drafts under docs/.
# The .tex is tracked; everything pdflatex regenerates from it is not.
docs/*.aux
docs/*.out
docs/*.toc
docs/*.log
docs/*.synctex.gz
docs/*.pdf

# PowerFactory project export (4.5 MB binary, regenerated from the PF
# database). Kept out of history; it is provenance for the RMS runs, not
# source, and a binary blob in git is a one-way cost.
*.pfd

# ---------------------------------------------------------------------------
# Local archive of removed files (2026-10-22)
# ---------------------------------------------------------------------------
# A local-only mirror of the project tree holding files the cleanup removed, at
# their original relative paths (`_local_archive/network/nordic32/...` and so
# on). Deliberately untracked: git history already holds every one of them, so
# a committed second copy would only add weight and a second place to look.
#
# It exists so a removed file can be read without a `git show`, and it is
# ignored here as well as excluded in the PyCharm project view, so it stays out
# of search, indexing and refactoring. Nothing imports from it and nothing
# should: it is a reading copy, not a code path.
#
# `_local_archive/README.md` records how it was generated and from which
# commits.
_local_archive/

# ---------------------------------------------------------------------------
# Local PowerShell launchers (2026-10-22)
# ---------------------------------------------------------------------------
# Campaign drivers parked out of the tree: machine-specific, path-specific and
# account-specific, so they are local tooling rather than source. The four here
# are the §9.2 dead-band producers, which is why they are parked rather than
# deleted -- see `local_ps_scripts/README.md` and the §9.2 row of
# `experiments/ch_9_parameter_selection/README.md`.
local_ps_scripts/
